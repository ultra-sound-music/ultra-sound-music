{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ultrasoundmusic.xyz/schema/artist-traits.json",
  "title": "ArtistTraitsRegistry",
  "type": "object",
  "required": ["drop", "schemaVersion", "artists"],
  "properties": {
    "drop": { "type": "string" },
    "schemaVersion": { "type": "string" },
    "artists": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artistId", "sanity", "swagger", "fame", "energy", "rhythm", "melody"],
        "properties": {
          "artistId": { "type": "string" },
          "sanity": { "type": "number", "minimum": 0, "maximum": 100 },
          "swagger": { "type": "number", "minimum": 0, "maximum": 100 },
          "fame": { "type": "number", "minimum": 0, "maximum": 100 },
          "energy": { "type": "number", "minimum": 0, "maximum": 100 },
          "rhythm": { "type": "number", "minimum": 0, "maximum": 100 },
          "melody": { "type": "number", "minimum": 0, "maximum": 100 }
        }
      }
    }
  }
}
