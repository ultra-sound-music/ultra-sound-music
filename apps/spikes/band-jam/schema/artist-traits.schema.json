{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ultrasoundmusic.xyz/schema/artist-traits.json",
  "title": "ArtistTraitsRegistry",
  "type": "object",
  "required": ["drop", "schemaVersion", "artists"],
  "properties": {
    "drop": { "type": "string" },
    "schemaVersion": { "type": "string" },
    "artists": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "artistId",
          "spark",
          "swagger",
          "fame",
          "melodicStyle",
          "rhythmicStyle",
          "energy"
        ],
        "properties": {
          "artistId": { "type": "string" },
          "spark": { "type": "number", "minimum": 0, "maximum": 100 },
          "swagger": { "type": "number", "minimum": 0, "maximum": 100 },
          "fame": { "type": "number", "minimum": 0, "maximum": 100 },
          "melodicStyle": { "enum": ["droning", "lyrical", "arpeggiated"] },
          "rhythmicStyle": { "enum": ["sustained", "flowing", "syncopated"] },
          "energy": { "type": "number", "minimum": 0, "maximum": 100 }
        }
      }
    }
  }
}
