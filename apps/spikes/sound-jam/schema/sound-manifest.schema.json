{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ultrasoundmusic.xyz/schema/sound-manifest.json",
  "title": "SoundManifest",
  "type": "object",
  "required": ["drop", "schemaVersion", "sounds"],
  "properties": {
    "drop": { "type": "string" },
    "schemaVersion": { "type": "string" },
    "sounds": {
      "type": "array",
      "items": { "$ref": "#/definitions/SoundManifestEntry" }
    }
  },
  "definitions": {
    "SoundManifestEntry": {
      "type": "object",
      "required": [
        "id",
        "sourceBot",
        "role",
        "bpm",
        "tempoRange",
        "meter",
        "bars",
        "keyCenter",
        "loopPoints",
        "durationSeconds",
        "beats",
        "loudness",
        "peak",
        "tags",
        "credit",
        "rights",
        "sourceHash",
        "canonicalUri",
        "playbackUri"
      ],
      "properties": {
        "id": { "type": "string" },
        "sourceBot": { "type": "string" },
        "role": { "enum": ["signature"] },
        "bpm": { "type": "number", "exclusiveMinimum": 0 },
        "tempoRange": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2
        },
        "meter": { "type": "string" },
        "bars": { "type": "integer", "minimum": 1 },
        "keyCenter": { "type": "string" },
        "loopPoints": {
          "type": "array",
          "items": { "type": "integer" },
          "minItems": 2,
          "maxItems": 2
        },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "beats": { "type": "number", "exclusiveMinimum": 0 },
        "loudness": { "type": "number" },
        "peak": { "type": "number", "minimum": 0, "maximum": 1 },
        "tags": { "type": "array", "items": { "type": "string" } },
        "credit": { "type": "string" },
        "rights": { "type": "string" },
        "sourceHash": { "type": "string" },
        "canonicalUri": { "type": "string" },
        "playbackUri": { "type": "string" }
      }
    }
  }
}
